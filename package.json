{
  "name": "cpv-enterprise-knowledge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3100",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3100",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/core.test.ts",
    "test:db": "node scripts/test-db.mjs",
    "prepare:corpus": "node scripts/prepare-corpus.mjs",
    "import:corpus": "tsx --env-file=.env.local scripts/import-corpus.ts",
    "bootstrap:owner": "tsx --env-file=.env.local scripts/bootstrap-owner.ts",
    "doctor": "tsx --env-file=.env.local scripts/doctor.ts"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "lucide-react": "1.64.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "supabase": "2.122.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
