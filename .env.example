# Copy to .env.local. Keep credentials outside source control.
APP_MODE=connected
APP_ORIGIN=http://localhost:3100
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server / worker only; prefer sb_secret_... over legacy service_role.
SUPABASE_SECRET_KEY=
CPV_ORG_ID=
CPV_OWNER_EMAIL=
DASHSCOPE_API_KEY=
# Beijing; replace with your workspace-specific cn-beijing endpoint if available.
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_CHAT_MODEL=qwen-plus
BAILIAN_TRANSLATE_MODEL=qwen-flash
BAILIAN_EMBEDDING_MODEL=text-embedding-v4
BAILIAN_TIMEOUT_MS=45000
# Worker: scanner required; errors stop processing.
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
WORKER_POLL_SECONDS=5
WORKER_MAX_PAGES=200
WORKER_MAX_CHARACTERS=150000
